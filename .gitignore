# Build output
bin/
obj/
out/
publish/
*.user
*.suo

# .NET
project.lock.json
*.nupkg
*.snupkg
.vs/
*.cache
*.pidb
*.svclog
*.scc

# Rider / VS Code
.idea/
.vscode/
*.sln.iml

# WebView2 user data
WebView2/
*.WebView2.UserData/

# Embedded JS build artifacts
src/Firepit.Web/Resources/node_modules/
src/Firepit.Web/Resources/dist/
src/Firepit.Web/Resources/*.tgz

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Logs
*.log
logs/

# User-local secrets / config overrides
*.local.json
.env
.env.local

# Firepit + Claude Code — shared config is versioned, runtime/personal is local.
# config.json, .claude/mcp.json, settings.json, commands/, agents/ stay tracked
# (declarative + shareable, no plaintext secrets — only ${cred:...} references).
# The rest below is ephemeral / per-machine / personal.
.firepit/inbox/
.firepit/runs/
# Derived knowledge index (M9) — rebuilt from .firepit/knowledge/*.md anytime.
.firepit/knowledge.db
.firepit/knowledge.db-wal
.firepit/knowledge.db-shm
.claude/*.lock
.claude/agent-memory/

# Test results
TestResults/
*.trx
coverage/
*.coverage
*.coveragexml

# Temp files
*.tmp
*.bak
*~
*.stackdump

# (Inno Setup output now lives under bin/installer — covered by `bin/` above)

# Firepit + Claude Code — shared config versioned, runtime/personal local
.firepit/knowledge.db*
!.firepit/config.json
.claude/settings.local.json

# Test fixtures are the exception to everything above. They are fake projects
# whose point is to be checked out complete — a .log or a .firepit file in
# there is content, not build output.
!tests/fixtures/**

# ...but output a running Firepit writes *into* a fixture is still output, and
# the exemption above would otherwise make a SQLite index committable in a
# public repo. Re-excluded here, after it, so this wins.
tests/fixtures/**/knowledge.db*
tests/fixtures/**/.firepit/runs/
tests/fixtures/**/.firepit/inbox/
tests/fixtures/**/.claude/settings.local.json

# Note for anyone adding a fixture: do not put files in a directory named
# `logs/`. Git does not descend into an excluded directory, so no negation can
# rescue what is inside one — the fixture log lives in `output/` for that
# reason, and `*.log` alone would have swallowed it too.
