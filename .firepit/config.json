{
  // Firepit per-project config. JSONC: comments and trailing commas are allowed.
  // Commands follow the Linux patterns of ../firepit-template/.firepit/config.json:
  // a group per area, a short lowercase name, a one-line description.

  "version": 1,
  "id": "firepit-ai",

  "commands": [
    {
      "group": "Build",
      "name": "debug",
      "description": "Builds the solution (Debug).",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "Firepit.slnx"],
      "keepOpenOnError": true
    },
    {
      "group": "Build",
      "name": "release",
      "description": "Builds the solution (Release).",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "Firepit.slnx", "-c", "Release"],
      "keepOpenOnError": true
    },

    {
      "group": "Install",
      "name": "service",
      "description": "Publishes firepitd and firepit-mcp and restarts the service.",
      "type": "shell",
      "command": "bash",
      "args": ["scripts/install-linux.sh"],
      "keepOpenOnError": true
    },

    {
      "group": "Test",
      "name": "all",
      "description": "Runs every test project; the result lands in the chat.",
      "type": "shell",
      "command": "dotnet",
      "args": ["test", "Firepit.slnx"],
      "window": "inline"
    },

    {
      "group": "Git",
      "name": "status",
      "description": "Branch and changed files.",
      "type": "shell",
      "command": "git",
      "args": ["status", "--short", "--branch"],
      "window": "inline"
    },
    {
      "group": "Git",
      "name": "repo",
      "description": "Opens the repository on GitHub.",
      "type": "url",
      "url": "https://github.com/SACRVM/firepit-ai"
    }
  ]
}
