<Window x:Class="Firepit.Views.InboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Inbox"
        Width="720"
        Height="600"
        MinWidth="460"
        MinHeight="360"
        Background="#1A1612"
        Icon="/firepit.ico"
        BorderBrush="#332B22"
        BorderThickness="1"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="InboxButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#A89F92" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#221C16" TargetName="Bd" />
                                <Setter Property="Foreground" Value="#E8E2D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A211A" TargetName="Bd" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InboxPrimaryButton" TargetType="Button" BasedOn="{StaticResource InboxButton}">
            <Setter Property="Background" Value="#2A211A" />
            <Setter Property="Foreground" Value="#F5C97B" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#332821" />
                    <Setter Property="Foreground" Value="#FFD89A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InboxDangerButton" TargetType="Button" BasedOn="{StaticResource InboxButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#E58A78" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CaptionRow" Height="32" />
            <RowDefinition Height="2*" MinHeight="96" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Caption -->
        <Grid Grid.Row="0" Background="#0A0805">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CaptionText"
                       Grid.Column="0"
                       Foreground="#A89F92"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="{DynamicResource BaseFontSize}"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0" />
            <Button Grid.Column="1"
                    Style="{StaticResource CaptionCloseButton}"
                    Width="{DynamicResource DialogCaptionPixelHeight}"
                    Height="{DynamicResource DialogCaptionPixelHeight}"
                    Click="OnCloseClick"
                    ToolTip="Close" />
        </Grid>

        <!-- Every pending message at a glance. Sender, subject and age are the
             whole triage surface — enough to decide, short enough to scan. -->
        <ListBox Grid.Row="1"
                 x:Name="MessageList"
                 Margin="12,10,12,0"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionChanged="OnMessageSelected">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,7" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Padding="{TemplateBinding Padding}"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="3">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1F1A14" TargetName="Bd" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2A211A" TargetName="Bd" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="●"
                                   Foreground="{Binding DotBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,9,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding From}"
                                   Foreground="#E8E2D8"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Width="160"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Subject}"
                                   Foreground="#A89F92"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding Age}"
                                   Foreground="#7A6F60"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="{DynamicResource SmallFontSize}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Full text of the selected message. Here for when the user wants to
             look, not something they have to read to act: the agent reads the
             file itself. Horizontal scroll stays off — enabling it measures the
             TextBox at infinite width, which silently defeats TextWrapping. -->
        <Border Grid.Row="2" Margin="20,10,20,12"
                Padding="12,10"
                Background="#0F0C09"
                BorderBrush="#332B22"
                BorderThickness="1"
                CornerRadius="3">
            <TextBox x:Name="BodyText"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     Foreground="#D4CCBE"
                     FontFamily="Cascadia Code, Consolas, Courier New"
                     FontSize="{DynamicResource BaseFontSize}"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled" />
        </Border>

        <!-- Action row -->
        <Grid Grid.Row="3" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    x:Name="ProcessButton"
                    Style="{StaticResource InboxPrimaryButton}"
                    Click="OnProcessClick"
                    ToolTip="Hand the inbox to this project's agent. It reads each message itself and stops to ask before anything irreversible.">
                <TextBlock x:Name="ProcessLabel" Text="Process all" />
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="DeleteButton"
                        Style="{StaticResource InboxDangerButton}"
                        Margin="0,0,6,0"
                        Click="OnDeleteClick"
                        ToolTip="Delete the selected message (removes the file)">
                    <TextBlock Text="Delete" />
                </Button>
                <Button x:Name="MarkDoneButton"
                        Style="{StaticResource InboxButton}"
                        Click="OnMarkDoneClick"
                        ToolTip="Move the selected message to inbox/processed/ without acting on it">
                    <TextBlock Text="Done" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
