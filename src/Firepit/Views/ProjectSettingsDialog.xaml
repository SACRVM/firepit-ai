<Window x:Class="Firepit.Views.ProjectSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Project settings"
        SizeToContent="Height"
        Width="600"
        Background="#1A1612"
        Icon="/firepit.ico"
        BorderBrush="#332B22"
        BorderThickness="1"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="32"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="0"
            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="DialogButtonBase" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#A89F92" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#221C16" TargetName="Bd" />
                                <Setter Property="Foreground" Value="#E8E2D8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A211A" TargetName="Bd" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5148" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogButtonBase}">
            <Setter Property="Background" Value="#2A211A" />
            <Setter Property="Foreground" Value="#F5C97B" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#332821" />
                    <Setter Property="Foreground" Value="#FFD89A" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DialogInlineButton" TargetType="Button" BasedOn="{StaticResource DialogButtonBase}">
            <Setter Property="Background" Value="#221C16" />
            <Setter Property="Foreground" Value="#E8E2D8" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E2D8" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
            <Setter Property="FontSize" Value="{DynamicResource MediumFontSize}" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8C7A5C" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
            <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ChoiceRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E8E2D8" />
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, Courier New" />
            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CaptionRow" Height="32" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#15110D">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="CaptionText"
                       Grid.Column="0"
                       Text="Project settings"
                       Foreground="#A89F92"
                       FontFamily="Cascadia Code, Consolas, Courier New"
                       FontSize="{DynamicResource BaseFontSize}"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0" />
            <Button Grid.Column="1"
                    Style="{StaticResource CaptionCloseButton}"
                    Width="{DynamicResource DialogCaptionPixelHeight}"
                    Height="{DynamicResource DialogCaptionPixelHeight}"
                    Click="OnCloseClick"
                    ToolTip="Close" />
        </Grid>

        <Grid Grid.Row="1" Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          Padding="0,0,4,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <StackPanel>
                    <TextBlock x:Name="ProjectPathText"
                               Style="{StaticResource Hint}"
                               Margin="0,0,0,18" />

                    <TextBlock Text="Knowledge" Style="{StaticResource SectionHeading}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Margin="0,4,0,10"
                               Text="Where this project's research and notes are stored. Keeping them out of a public repo means they are never committed where anyone can read them." />

                    <RadioButton x:Name="InRepoChoice"
                                 Style="{StaticResource ChoiceRadio}"
                                 GroupName="Storage"
                                 Content="In this repo"
                                 Checked="OnChoiceChanged" />
                    <TextBlock x:Name="InRepoHint" Style="{StaticResource Hint}" Margin="20,0,0,10" />

                    <RadioButton x:Name="HostedChoice"
                                 Style="{StaticResource ChoiceRadio}"
                                 GroupName="Storage"
                                 Content="Hosted privately in the .firepit repo"
                                 Checked="OnChoiceChanged" />
                    <TextBlock x:Name="HostedHint" Style="{StaticResource Hint}" Margin="20,0,0,10" />

                    <RadioButton x:Name="CustomChoice"
                                 Style="{StaticResource ChoiceRadio}"
                                 GroupName="Storage"
                                 Content="Another folder"
                                 Checked="OnChoiceChanged" />
                    <TextBlock Style="{StaticResource Hint}"
                               Margin="20,0,0,6"
                               Text="Point several projects at one folder to give them a shared knowledge base." />
                    <Grid Margin="20,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomPathBox"
                                 Grid.Column="0"
                                 Background="#15110D"
                                 Foreground="#E8E2D8"
                                 BorderBrush="#332B22"
                                 BorderThickness="1"
                                 CaretBrush="#E8E2D8"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontSize="{DynamicResource BaseFontSize}"
                                 Padding="8,6"
                                 TextChanged="OnCustomPathChanged" />
                        <Button x:Name="BrowseButton"
                                Grid.Column="1"
                                Content="Browse…"
                                Style="{StaticResource DialogInlineButton}"
                                Margin="6,0,0,0"
                                Click="OnBrowseClick" />
                    </Grid>

                    <Border x:Name="StatusBox"
                            Background="#15110D"
                            BorderBrush="#332B22"
                            BorderThickness="1"
                            Padding="12,10"
                            Margin="0,8,0,0">
                        <TextBlock x:Name="StatusText"
                                   Foreground="#A89F92"
                                   FontFamily="Cascadia Code, Consolas, Courier New"
                                   FontSize="{DynamicResource SmallFontSize}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="OpenFolderButton"
                        Content="Show in Explorer"
                        Style="{StaticResource DialogButtonBase}"
                        Margin="0,0,8,0"
                        Click="OnShowInExplorerClick" />
                <Button x:Name="SaveButton"
                        Content="Save"
                        Style="{StaticResource DialogPrimaryButton}"
                        Margin="0,0,6,0"
                        IsDefault="True"
                        Click="OnSaveClick" />
                <Button Content="Cancel"
                        Style="{StaticResource DialogButtonBase}"
                        IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
